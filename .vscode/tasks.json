{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*VITE v.*dev.*$",
          "endsPattern": "^.*Local:.*http://localhost:5173/.*$"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "detail": "Запуск dev-сервера Biznes-Maslahatchi AI (Vite + React)"
    }
  ]
}
